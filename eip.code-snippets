{
	"EIP Tooltip (Интерактивный термин)": {
		"prefix": "eip-tooltip",
		"body": [
			"<span class=\"term-keyword\" onclick=\"openPopover(event, '$2')\">$1</span>"
		],
		"description": "Всплывающая подсказка (поповер) для сложных терминов"
	},
	"EIP Callout Warning (Желтое предупреждение)": {
		"prefix": "eip-warning",
		"body": [
			"<div class=\"callout-box warning-type\">",
			"\t<strong>${1:Внимание:}</strong> ${2:Текст предупреждения}",
			"</div>"
		],
		"description": "Блок предупреждения (желтый)"
	},
	"EIP Callout Info (Синяя сноска)": {
		"prefix": "eip-info",
		"body": [
			"<div class=\"callout-box\">",
			"\t<strong>${1:К сведению:}</strong> ${2:Текст информации}",
			"</div>"
		],
		"description": "Информационный блок (синий)"
	},
	"EIP Callout Success (Зеленое правило)": {
		"prefix": "eip-success",
		"body": [
			"<div class=\"callout-box success-type\">",
			"\t<strong>${1:Правило:}</strong> ${2:Текст правила}",
			"</div>"
		],
		"description": "Блок успешного действия или правила (зеленый)"
	},
	"EIP Page Template (Новая страница)": {
		"prefix": "eip-page",
		"body": [
			"<!DOCTYPE html>",
			"<html lang=\"ru\">",
			"<head>",
			"\t<meta charset=\"UTF-8\">",
			"\t<title>${1:Название}</title>",
			"\t<link rel=\"stylesheet\" href=\"style.css\">",
			"</head>",
			"<body class=\"${2:page-class}\">",
			"\t${3:<!-- Контент -->}",
			"</body>",
			"</html>"
		],
		"description": "Базовый шаблон новой страницы ЕИП"
	},
	"EIP Article Block (Контейнер статьи)": {
		"prefix": "eip-article",
		"body": [
			"<div class=\"article-page\" id=\"${1:id_раздела}\">",
			"\t<h1>${2:Главный заголовок статьи}</h1>",
			"\t<div class=\"article-body\">",
			"\t\t<p>${3:Текст начинается здесь...}</p>",
			"\t</div>",
			"</div>"
		],
		"description": "Скрытый блок с новой статьей для центральной панели"
	},
	"EIP Menu Item (Пункт меню)": {
		"prefix": "eip-menu-item",
		"body": [
			"<button class=\"menu-item\" data-article=\"${1:id_раздела}\" onclick=\"switchTab(this)\">📄 ${2:Название в меню}</button>"
		],
		"description": "Кнопка для левого меню (переключает на нужную статью)"
	},
	"EIP Instruction Image (Картинка с зумом)": {
		"prefix": "eip-img",
		"body": [
			"<img src=\"${1:img/имя_файла.png}\" alt=\"${2:Описание скриншота}\" class=\"instruction-img\" onclick=\"openFullscreenImage(this.src)\">"
		],
		"description": "Скриншот инструкции, который увеличивается по клику"
	},
	"EIP Compare Table Row (Строка Было/Стало)": {
		"prefix": "eip-tablerow",
		"body": [
			"<tr>",
			"\t<td class=\"old-process\">",
			"\t\t<b>${1:Было:}</b> ${2:Описание старого процесса}",
			"\t</td>",
			"\t<td class=\"new-process\">",
			"\t\t<b>${3:Стало:}</b> ${4:Описание нового процесса}",
			"\t</td>",
			"</tr>"
		],
		"description": "Добавляет новую строку в сравнительную таблицу"
	}
}